# Logger
BE_LOGGER_FORMAT=json
BE_LOGGER_LEVEL=info
BE_LOGGER_DRIVER=zerolog

# Public base URL this app is served at (used to build presigned/proxy download links)
BE_BASE_URL=http://127.0.0.1:8080

# HTTP server
# The backend always listens on :80 (hardcoded) - it's the container's sole
# public ingress, reverse-proxying the frontend and MinIO itself.
BE_HTTP_SERVER_READ_TIMEOUT=30s
BE_HTTP_SERVER_SHUTDOWN_TIMEOUT=10s
BE_HTTP_CORS_ALLOWED_ORIGINS=*

# Postgres
BE_POSTGRES_HOST=127.0.0.1
BE_POSTGRES_PORT=5432
BE_POSTGRES_USERNAME=CHANGE_ME
BE_POSTGRES_PASSWORD=CHANGE_ME
BE_POSTGRES_DATABASE=mate-things
BE_POSTGRES_SSL_MODE=disable
BE_POSTGRES_MAX_CONNECTIONS=20
BE_POSTGRES_CONNECT_TIMEOUT=10s

# Redis
BE_REDIS_ADDRESSES=127.0.0.1:6379
BE_REDIS_PASSWORD=CHANGE_ME
BE_REDIS_DATABASE=0
BE_REDIS_CONNECT_TIMEOUT=10s
BE_REDIS_CACHE_NAMESPACE=mate-things
BE_REDIS_TTL_IDENTITY=30m
BE_REDIS_TTL_PAGINATION=5m
BE_REDIS_TTL_RELATION=10m

# Minio / S3-compatible object storage
BE_MINIO_ENDPOINT=127.0.0.1:8333
BE_MINIO_ACCESS_KEY=CHANGE_ME
BE_MINIO_SECRET_KEY=CHANGE_ME
BE_MINIO_BUCKET=mate-things
BE_MINIO_USE_SSL=false
BE_MINIO_REGION=
BE_MINIO_CONNECT_TIMEOUT=10s
BE_MINIO_PRESIGN_DURATION=5m

# MQTT
BE_MQTT_BROKER_URL=ssl://hivemq.broker.com:8883
BE_MQTT_CLIENT_ID=mate-things-backend
BE_MQTT_USERNAME=CHANGE_ME
BE_MQTT_PASSWORD=CHANGE_ME
BE_MQTT_CONNECT_TIMEOUT=10s
BE_MQTT_KEEP_ALIVE=30s
BE_MQTT_PING_TIMEOUT=10s

# Tokens
BE_TOKEN_ACCESS_SECRET=CHANGE_ME
BE_TOKEN_REFRESH_SECRET=CHANGE_ME
BE_TOKEN_ACCESS_DURATION=15m
BE_TOKEN_REFRESH_DURATION=24h

# Password hashing
BE_PASSWORD_BCRYPT_COST=10

# LLM encryption (must be exactly 32 bytes for AES-256)
BE_LLM_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_KEY_1234567890
