# Logger
BE_LOGGER_FORMAT=json
BE_LOGGER_LEVEL=info
BE_LOGGER_DRIVER=zerolog

# HTTP server
BE_HTTP_SERVER_PORT=8080
BE_HTTP_SERVER_READ_TIMEOUT=30s
BE_HTTP_SERVER_SHUTDOWN_TIMEOUT=10s
BE_HTTP_CORS_ALLOWED_ORIGINS=*

# Postgres
BE_POSTGRES_HOST=127.0.0.1
BE_POSTGRES_PORT=5432
BE_POSTGRES_USERNAME=postgres
BE_POSTGRES_PASSWORD=postgres
BE_POSTGRES_DATABASE=nusapala_things
BE_POSTGRES_SSL_MODE=disable
BE_POSTGRES_MAX_CONNECTIONS=20
BE_POSTGRES_CONNECT_TIMEOUT=10s

# Redis
BE_REDIS_ADDRESSES=127.0.0.1:6379
BE_REDIS_PASSWORD=
BE_REDIS_DATABASE=0
BE_REDIS_CONNECT_TIMEOUT=10s
BE_REDIS_CACHE_NAMESPACE=nusapala-things
BE_REDIS_TTL_IDENTITY=30m
BE_REDIS_TTL_PAGINATION=5m
BE_REDIS_TTL_RELATION=10m

# Minio / S3-compatible object storage
BE_MINIO_ENDPOINT=127.0.0.1:8333
BE_MINIO_ACCESS_KEY=nusapala
BE_MINIO_SECRET_KEY=nusapala-secret
BE_MINIO_BUCKET=nusapala-things
BE_MINIO_USE_SSL=false
BE_MINIO_REGION=
BE_MINIO_CONNECT_TIMEOUT=10s

# MQTT
BE_MQTT_BROKER_URL=tcp://127.0.0.1:1883
BE_MQTT_CLIENT_ID=nusapala-things-backend
BE_MQTT_USERNAME=
BE_MQTT_PASSWORD=
BE_MQTT_CONNECT_TIMEOUT=10s
BE_MQTT_KEEP_ALIVE=30s
BE_MQTT_PING_TIMEOUT=10s

# Tokens
BE_TOKEN_ACCESS_SECRET=nusapala-things-access-secret
BE_TOKEN_REFRESH_SECRET=nusapala-things-refresh-secret
BE_TOKEN_ACCESS_DURATION=15m
BE_TOKEN_REFRESH_DURATION=24h

# Password hashing
BE_PASSWORD_BCRYPT_COST=10
